# Create a free key at https://www.weatherapi.com/ and add it to Vercel as WEATHERAPI_KEY.
WEATHERAPI_KEY=

# Optional token supplied when you verify the domain in Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Resend powers the contact form and newsletter subscriber list.
RESEND_API_KEY=
# Create a "Love Long Eaton Weekend" segment in Resend and paste its ID here.
RESEND_SEGMENT_ID=
# Must use a domain verified in Resend. The app defaults to this address.
CONTACT_FROM_EMAIL="Love Long Eaton <website@midasweb.org>"

# Protects Vercel's scheduled weekly newsletter endpoint. Use 16+ random characters.
CRON_SECRET=
